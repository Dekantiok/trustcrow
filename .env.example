# Copy to .env and fill in. Never commit the real .env.

# --- Django ------------------------------------------------------------------
# Required unless DJANGO_DEBUG=True
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# --- Paystack ----------------------------------------------------------------
# Live keys start sk_live_ / pk_live_. Test keys start sk_test_.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Termii (Nigerian email OTP) ---------------------------------------------
TERMII_API_KEY=
TERMII_EMAIL_CONFIG_ID=

# --- Tunables ----------------------------------------------------------------
# Seconds before an outbound gateway call is abandoned.
GATEWAY_HTTP_TIMEOUT=15
# Minimum gap between OTPs sent to the same address for the same purpose.
OTP_ISSUE_COOLDOWN_SECONDS=60
# Print one-time codes to the log. Leave off outside local development.
LOG_OTP_TO_CONSOLE=False
LOG_LEVEL=INFO

# --- Required when DJANGO_DEBUG=False ---------------------------------------
CSRF_TRUSTED_ORIGINS=https://escrow.example.com
SECURE_SSL_REDIRECT=True
